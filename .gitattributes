# Default text normalization for cross-platform agent work.
* text=auto eol=lf

# Windows entry points should keep CRLF in checkout.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
